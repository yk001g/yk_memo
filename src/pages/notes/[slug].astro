---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, dateDisplay, updated, tags, lede, status } = entry.data;
---

<BaseLayout title={`${title} — yk_memo`} description={description}>

<main>
  <article>
    <header class="wrap">
      <div class="measure">
        <div class="article-meta-top">
          <time class="article-date" datetime={date}>{dateDisplay}</time>
          <span class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-lede">{lede}</p>
      </div>
    </header>

    <div class="wrap">
      <div class="article-body">

        {status === 'draft' ? (
          <p>(この記事はまだ準備中です。)</p>
        ) : (
          <Content />
        )}

      </div>

      <footer class="article-end">
        <p class="pub-meta">
          {dateDisplay} 公開
          {updated && ` ／ ${updated} 更新`}
        </p>
        <p class="back-link"><a href="/notes/">← Notes に戻る</a></p>

        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">関連する記事</h2>
          <ul>
            <li>
              <a href="/notes/salon-ai-hajimete/">
                <span class="rel-title">スマホサロンで「AI に聞いてみる」を覚えた日</span>
                <span class="rel-date">2026.04.18</span>
              </a>
            </li>
            <li>
              <a href="/notes/notebooklm-mcp-cli/">
                <span class="rel-title">notebooklm-mcp-cli を導入してみた</span>
                <span class="rel-date">2026.03.21</span>
              </a>
            </li>
          </ul>
        </section>
      </footer>
    </div>

  </article>
</main>

</BaseLayout>

<style>
  /* ---- Article header ---- */
  article { padding: 56px 0 0; }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
    font-variant-numeric: tabular-nums;
  }
  .article-meta-top .tags {
    display: flex;
    gap: 10px;
    color: var(--color-accent);
  }
  .article-meta-top .tags .tag::before {
    content: "#";
    opacity: 0.6;
    margin-right: 1px;
  }

  .article-title {
    font-size: 34px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 16px 0;
    color: var(--color-text);
    text-wrap: pretty;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .article-lede {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 64px 0;
    text-wrap: pretty;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  /* ---- Article body ---- */
  .article-body {
    font-size: 17px;
    line-height: var(--lh-article);
    color: var(--color-text);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .article-body > * {
    max-width: var(--max-width-article);
    margin-left: auto;
    margin-right: auto;
  }
  .article-body > .wide { max-width: var(--max-width-article-wide); }

  .article-body p { margin: 0 0 1.2em 0; }
  .article-body p:last-child { margin-bottom: 0; }

  .article-body h2 {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    margin: 56px auto 16px;
    color: var(--color-text);
  }
  .article-body h3 {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    margin: 40px auto 12px;
    color: var(--color-text);
  }

  .article-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .article-body a:hover {
    text-decoration-color: var(--color-accent-warm);
    text-decoration-thickness: 2px;
  }

  .article-body strong { font-weight: 600; color: var(--color-text); }

  .article-body code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    word-break: break-all;
  }

  .article-body blockquote {
    margin: 24px auto;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--color-accent);
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    font-style: normal;
  }
  .article-body blockquote p { margin: 0 0 0.8em 0; }
  .article-body blockquote p:last-child { margin: 0; }

  .article-body pre {
    margin: 24px auto;
    padding: 20px;
    background: var(--color-bg-soft);
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
  }
  .article-body pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    word-break: normal;
  }

  .article-body ul,
  .article-body ol {
    padding-left: 24px;
    margin: 0 auto 1.2em;
    max-width: var(--max-width-article);
  }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body li { margin: 6px 0; padding-left: 4px; }
  .article-body li::marker { color: var(--color-text-secondary); }

  .article-body hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    width: 100px;
    margin: 48px auto;
  }

  .article-body figure { margin: 32px auto; }
  .article-body figure img,
  .article-body figure .placeholder {
    display: block;
    max-width: 100%;
    margin: 0 auto;
  }
  .article-body figcaption {
    margin-top: 12px;
    font-size: 12px;
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.6;
  }

  .placeholder {
    border: 1px solid var(--color-border);
    background: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      rgba(44,44,42,0.035) 9px 10px
    );
    aspect-ratio: 16 / 9;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: 2px;
  }

  /* ---- Article footer ---- */
  .article-end {
    margin-top: 64px;
    max-width: var(--max-width-article);
    margin-left: auto;
    margin-right: auto;
  }

  .pub-meta {
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    margin: 0 0 12px 0;
    letter-spacing: 0.02em;
  }

  .back-link { font-size: 14px; }
  .back-link a { color: var(--color-accent); }

  .related {
    margin-top: 48px;
    max-width: var(--max-width-article);
    margin-left: auto;
    margin-right: auto;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .related h2 {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin: 0 0 18px 0;
    letter-spacing: 0.02em;
  }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li { padding: 10px 0; }

  .related a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-text);
  }
  .related a:hover { text-decoration: none; }

  .rel-title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.5;
    transition: color .15s ease;
  }
  .related a:hover .rel-title { color: var(--color-accent); }

  .rel-date {
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    article { padding-top: 32px; }
    .article-title { font-size: 26px; }
    .article-lede { font-size: 17px; margin-bottom: 48px; }
    .article-body h2 { margin-top: 44px; font-size: 20px; }
    .article-body h3 { margin-top: 32px; }
    .article-body pre { padding: 16px; font-size: 13px; }
  }
</style>
