---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'claude-design-1day-build' } },
    { params: { slug: 'claude-skills-kyozai' } },
    { params: { slug: 'salon-ai-hajimete' } },
    { params: { slug: 'notebooklm-mcp-cli' } },
  ];
}

const { slug } = Astro.params;

type Article = {
  title: string;
  description: string;
  date: string;
  dateDisplay: string;
  updated?: string;
  tags: string[];
  lede: string;
};

const articles: Record<string, Article> = {
  'claude-design-1day-build': {
    title: 'シニア教育者がClaude Designで個人HPを1日で作った話｜つまずいた7箇所と解決策',
    description: 'Claude Design・Claude Code・Vercelを組み合わせると、プログラミング経験がほぼゼロでも個人サイトを1日で公開できます。シニア教育者が実際に転んだ7箇所のつまずきと解決策を、時系列で記録した実践レポートです。',
    date: '2026-04-26',
    dateDisplay: '2026.04.26',
    tags: ['道具', '教育'],
    lede: 'プログラミング経験がほぼゼロのシニア教育者が、Claude DesignとClaude Codeで個人サイトを1日で完成・公開した実体験レポート。転んだ7箇所の原因と解決策、非エンジニア向けの再現手順を時系列でまとめました。',
  },
  'claude-skills-kyozai': {
    title: 'Claude Skills を教材づくりに使う',
    description: '毎月の講座資料を Skill として切り出し、更新コストを半分以下にする。1ヶ月運用してみたワークフローの記録。',
    date: '2026-04-02',
    dateDisplay: '2026.04.02',
    updated: '2026.04.20',
    tags: ['道具', '教育'],
    lede: '毎月の講座資料を Skill として切り出し、更新コストを半分以下にする。1ヶ月運用してみたワークフローの記録。',
  },
  'salon-ai-hajimete': {
    title: 'スマホサロンで「AIに聞いてみる」を覚えた日',
    description: '70代の参加者が初めて生成AIに質問を投げた朝の記録。うまくいった会話と、すれ違った会話の両方について。',
    date: '2026-04-18',
    dateDisplay: '2026.04.18',
    tags: ['教育', 'AI'],
    lede: '70代の参加者が初めて生成AIに質問を投げた朝の記録。うまくいった会話と、すれ違った会話の両方について。',
  },
  'notebooklm-mcp-cli': {
    title: 'notebooklm-mcp-cli を導入してみた',
    description: 'NotebookLM を MCP 経由で呼び出す構成。自分のノートと講座資料をつなぐ実験。',
    date: '2026-03-21',
    dateDisplay: '2026.03.21',
    tags: ['道具', 'Obsidian'],
    lede: 'NotebookLM を MCP 経由で呼び出す構成。自分のノートと講座資料をつなぐ実験。',
  },
};

const article = articles[slug!];
---

<BaseLayout title={`${article.title} — yk_memo`} description={article.description}>

<main>
  <article>
    <header class="wrap">
      <div class="measure">
        <div class="article-meta-top">
          <time class="article-date" datetime={article.date}>{article.dateDisplay}</time>
          <span class="tags">
            {article.tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        </div>
        <h1 class="article-title">{article.title}</h1>
        <p class="article-lede">{article.lede}</p>
      </div>
    </header>

    <div class="wrap">
      <div class="article-body">

        {slug === 'claude-skills-kyozai' && (
          <>
            <p>片倉台のスマホサロンと市民講座を合わせると、毎月 3 〜 4 種類の配布資料を書いている。テーマは少しずつ違うのだけれど、骨格は驚くほど似ていて、いつも同じところでつまずき、同じところを書き直している。</p>

            <p>今月から、その骨格を Claude の <a href="https://www.anthropic.com/news/skills" rel="noopener">Skills</a> として切り出してみることにした。結論から書くと、資料 1 本あたりの作業時間が体感で半分以下になった。完成度の高さよりも、書き始めるまでの心理的なコストが下がったのが大きい。</p>

            <p>このメモは、その 1 ヶ月の記録と、来月以降に調整したい点の整理。</p>

            <h2>これまでの講座資料づくりの問題</h2>

            <p>毎月の講座資料は、だいたい次のような工程で作っていた。</p>

            <ul>
              <li>テーマを決める（参加者の質問やニュースから拾う）</li>
              <li>90 分ぶんの構成案を書く</li>
              <li>A4 1 〜 2 枚の配布プリントを書く</li>
              <li>プリントを読み上げ用台本に直す</li>
              <li>当日の質問メモ用のフォームを準備する</li>
            </ul>

            <p>このうち、最初の <strong>テーマを決める〜構成案を書く</strong> までが、いつも一番重い。書き始めると進むのに、白紙に向かって構成を決めるのが、月のいちばんしんどい仕事だった。</p>

            <p>後半 3 つはほとんど機械的なのに、そこに辿り着く前に体力を使い切ってしまうことが多かった。</p>

            <h2>Skill として切り出す</h2>

            <h3>設計の考え方</h3>

            <p>Anthropic の <a href="https://docs.anthropic.com/" rel="noopener">公式ドキュメント</a> を読みつつ、最初に作ったのは <code>lesson-plan</code> という Skill。「目的」「参加者像」「持ち時間」を入力すると、90 分の講座構成案を出してくれる、ただそれだけのもの。</p>

            <p>大事だったのは、Skill のなかに <strong>シニア向け講座の制約</strong> を書き込んでおいたこと。文字は 14pt 以上。1 スライドに 1 メッセージ。専門用語は定義してから使う。「アプリ」と「サービス」を混ぜない。こうした制約は毎月同じなのに、毎月思い出しながら書いていた。Skill にしておけば、思い出さなくて済む。</p>

            <blockquote>
              <p>シニアにとっての「わかりにくい」は、難易度よりも一貫性の問題だ。先週の言い方と今週の言い方が違う、それだけで講座は途切れる。</p>
            </blockquote>

            <p>Skill はこの種の <em>暗黙知</em> を、文章として残しておく場所として使うのがいいと思っている。</p>

            <h3>実際のディレクトリ構成</h3>

            <p>1 ヶ月運用したあとの、いまのディレクトリはだいたいこんな具合になっている。</p>

            <pre><code>{`skills/
├── lesson-plan/
│   ├── SKILL.md
│   ├── examples/
│   │   ├── 2026-04-ai-search.md
│   │   └── 2026-03-photo-share.md
│   └── constraints/
│       └── senior-audience.md
├── handout-jp/
│   ├── SKILL.md
│   └── templates/
│       └── a4-2page.md
└── salon-notes/
    └── SKILL.md`}</code></pre>

            <p>各 Skill のルートには <code>SKILL.md</code> を 1 枚置き、参照させたい例や制約は別ファイルに切り出す。<code>examples/</code> に過去の講座を 2 〜 3 本入れておくと、トーンが安定する。</p>

            <figure>
              <div class="placeholder" role="img" aria-label="ワークフロー図のプレースホルダ">
                illustration · workflow diagram
              </div>
              <figcaption>テーマ決定から配布までの工程と、各工程に対応する Skill の対応図（差し替え予定）。</figcaption>
            </figure>

            <h2>1 ヶ月運用してみた</h2>

            <p>4 月の 4 本の講座すべてで、この組み合わせを使った。実感として一番効いたのは、<strong>白紙に向かう時間が減ったこと</strong>。Skill が骨格を出してくれるので、そこに肉付けする作業から始められる。</p>

            <p>一方で、Skill が出すものを <em>そのまま使った回</em> はゼロ。毎回どこかを書き直している。これは悪いことではなく、書き直しながら自分の意図を確かめている感じがある。</p>

            <blockquote>
              <p>Skill は「出力を担う道具」ではなく「自分の判断を引き出す道具」として使うのが、いまのところ自分には合っている。</p>
            </blockquote>

            <p>参加者の反応も、いつもと同じか、少しよかった気がする。資料の <strong>骨組みが安定した</strong> ことで、当日のアドリブに余裕が出たのだと思う。</p>

            <h2>これからの調整ポイント</h2>

            <ul>
              <li>講座後の <strong>ふりかえりメモ</strong> を Skill から自動生成する流れを作る</li>
              <li>シニア向けの言い換え辞書を <code>constraints/</code> に蓄積する</li>
              <li>配布プリントの版面（A4 縦）テンプレを Skill に同梱する</li>
              <li>来月の市民講座で取り上げる Antigravity 用の Skill を新規に書き起こす</li>
            </ul>

            <p>来月もまた、月末にこのページを更新するつもり。続報は <a href="/notes/">Notes</a> から。</p>
          </>
        )}

        {slug === 'claude-design-1day-build' && (
          <>
            <p><strong>Claude DesignとClaude CodeとVercelを組み合わせると、プログラミング経験がほぼゼロでも、個人HPを1日で公開できます。</strong> 実際に私が4月25日から26日にかけて体験した手順を、つまずいた7箇所と解決策つきで共有します。</p>

            <p>私は八王子・片倉台で月次のスマホ・わいわいサロンを運営している、シニア向けAIリテラシー教育者です。yk_memo というブランドで活動しています。今回、Anthropic社が公開したばかりの「Claude Design」を使い、自分自身のサイトを構築・公開しました。</p>

            <p>この記事を読み終えると、次の3つがわかります。</p>

            <ul>
              <li>Claude Design・Claude Code・Vercelの3ツールが、それぞれ何を担うのか</li>
              <li>1日のスケジュールで、どのフェーズに何時間かかるのか</li>
              <li>非エンジニアが実際に転ぶポイントと、その乗り越え方</li>
            </ul>

            <blockquote>
              <p>【現場レポ】2026年4月25日〜26日にかけての、Claude Design 公開直後の処女作体験です。鮮度のあるうちに、つまずいた箇所も含めてそのまま記録しています。</p>
            </blockquote>

            <p>対象読者は、<strong>40〜60代の自営業・小規模事業主・教育関係者</strong>です。WordPressやJimdoは触ったことがあるが、HTMLは書けない。そんな立ち位置の方を想定しています。</p>

            <hr />

            <h2>なぜシニア教育者の私がClaude DesignでHPを作ろうと思ったのか?</h2>

            <p><strong>きっかけは「AIと競争しない、自分のベストで使う」という個人的な哲学です。AIに教える立場の自分が、AIを最大限使えていなければ説得力がない。その気づきから、Claude Design 公開のニュースを見た瞬間、自分のサイトで試そうと決めました。</strong></p>

            <h3>月次サロンの現場で見えていること</h3>

            <p>私は毎月、地元のシニア向けにスマホ・わいわいサロンを開いています。受講者の多くは70代以上で、AIに対する印象は「便利そう」と「怖い」の間で揺れています。</p>

            <p>ある受講者の方が、こう言いました。「私たちの世代は、AIに置き換えられて終わりですね」。この言葉は何度も聞いてきました。</p>

            <p>私の答えはいつも同じです。「AIと競争しないでください。自分のベストで使ってください」。</p>

            <p>このメッセージを伝え続けるには、自分自身がAIを最大限活用している姿を見せる必要があります。教える人間が使えていなければ、説得力はゼロです。</p>

            <h3>Claude Design を選んだ理由は3つあります</h3>

            <p>数あるAIツールの中で、なぜ Claude Design だったのか。理由は次の3つです。</p>

            <table>
              <thead>
                <tr><th>理由</th><th>内容</th></tr>
              </thead>
              <tbody>
                <tr><td>① ハンドオフが消える</td><td>デザイン（Claude Design）と実装（Claude Code）が同じ文脈で繋がる</td></tr>
                <tr><td>② シニア教育の事例として強い</td><td>公開直後で前例が少ないため、「私の体験」が一次情報になる</td></tr>
                <tr><td>③ yk_memo ブランドとの相性</td><td>サイトを「教材」として展示できる</td></tr>
              </tbody>
            </table>

            <p>特に①が決定的でした。一般的なWeb制作では、デザイナーが作ったデザインをエンジニアがコード化する際に、「この余白は何pxですか?」「このフォントは何を使っていますか?」という確認が無数に発生します。これを「ハンドオフ」と呼びます。</p>

            <blockquote>
              <p>【哲学】月次サロンで「AIに置き換えられる」と不安を口にする受講者を、私はこれまで数十人見てきました。技術がない人ほど、AIとの協働で得られるレバレッジは大きい。今回のサイト制作は、そのことを自分の身体で確かめる実践でした。</p>
            </blockquote>

            <p>Claude Design と Claude Code の組み合わせでは、このハンドオフが消えます。デザインを作ったAIと、それをコードにするAIが、同じ会話の延長線上にいるからです。</p>

            <h3>既存ツールとの違いは「対話で進む」ことです</h3>

            <p>WordPressやJimdoを触ったことがある方なら、こう思うかもしれません。「テンプレート選んで色を変えればいいだけでしょう?」と。</p>

            <p>それも一つの作り方です。ただ、Claude Design の体験はもう一段違います。「テキストでイメージを伝えると、画面案がいきなり出てくる」のです。テンプレートを選ぶのではなく、自分の言葉でデザインを引き出す感覚に近い。</p>

            <p>この違いは、実際にやってみないと伝わりにくいです。次のセクションで、3ツールの役割分担を具体的に整理します。</p>

            <hr />

            <h2>Claude Design・Claude Code・Vercelの役割分担とは?</h2>

            <p><strong>Claude Designがデザインを生成し、Claude Codeがそのデザインをコード化、Vercelが公開を担います。3つが同じ文脈で繋がるため、デザイナーとエンジニアの間に発生する「ハンドオフ」(仕様伝達の手戻り)が消えます。これが従来のWeb制作との最大の違いです。</strong></p>

            <h3>従来のWeb制作と何が違うのか?</h3>

            <p>まず、3ツールの位置づけを整理する前に、従来のWeb制作の流れを確認します。</p>

            <table>
              <thead>
                <tr><th>フェーズ</th><th>従来のWeb制作</th><th>Claude連携の制作</th></tr>
              </thead>
              <tbody>
                <tr><td>デザイン</td><td>デザイナーがFigmaで作成</td><td>Claude Designが対話で生成</td></tr>
                <tr><td>ハンドオフ</td><td>デザイナー→エンジニアへ仕様書を渡す</td><td><strong>このフェーズが消える</strong></td></tr>
                <tr><td>実装</td><td>エンジニアがコードを書く</td><td>Claude Codeがコード化</td></tr>
                <tr><td>公開</td><td>サーバー設定・FTPアップロード</td><td>Vercelがワンクリックで公開</td></tr>
                <tr><td>修正</td><td>デザイナー・エンジニアの双方に依頼</td><td>同じClaudeとの会話で完結</td></tr>
              </tbody>
            </table>

            <p>特に重要なのは「ハンドオフが消える」点です。従来は、「この余白は何pxですか?」「このフォントは何を使っていますか?」「このアニメーションの細かい挙動は?」といった確認が無数に発生します。デザインとコードの間で意図のズレが起きやすく、ここで時間が溶けます。</p>

            <p>Claude Design と Claude Code は、同じ会話の延長線上で動きます。デザインを作った文脈をそのまま実装に持ち込めるため、解釈の違いが生まれる余地がありません。</p>

            <h3>Claude Design は何ができるツールか?</h3>

            <p><strong>Claude Design は、テキストでイメージを伝えると、Webサイトのデザイン案をブラウザ上で生成してくれるツールです。Anthropic社が提供する、Claudeシリーズのデザイン特化版だと考えてください。</strong></p>

            <p>主にできることは次の通りです。</p>

            <ul>
              <li>ファーストビュー（トップ画面）のデザイン案を複数生成</li>
              <li>ページ内のセクション（特徴、料金、お問い合わせ等）の追加</li>
              <li>配色・フォント・余白の調整</li>
              <li>複数ページにわたるデザインの一括生成</li>
              <li>生成したデザインの HTML/CSS としての書き出し</li>
            </ul>

            <p>私の場合、4月25日の朝〜午後にかけて、トップページ・About・Notes・Lessons・Salonの5画面分のデザインを、対話だけで完成させました。</p>

            <blockquote>
              <p>【現場レポ】Claude Design の画面を初めて開いた瞬間、「これは今までのデザインツールと違う」と感じました。テキストでイメージを伝えると、いきなり完成度の高い画面案が出てくる。Figmaで2日かけて作っていた工程が、対話で進んでいきます。</p>
            </blockquote>

            <p>注意点として、Claude Design は本記事執筆時点（2026年4月）で公開されたばかりのツールです。Pro プラン以上での利用が必要で、無料プランでは使えません。</p>

            <h3>Claude Code は Claude Design とどう繋がるのか?</h3>

            <p><strong>Claude Code は、ターミナル（黒い画面）で動くAIコーディング支援ツールです。Claude Design で作ったデザインを、実際に動くWebサイトのコードへ変換する役割を担います。</strong></p>

            <p>Claude Design で生成された HTML を、Claude Code が次のような形で実装に落とし込みます。</p>

            <ul>
              <li>HTMLを Astro という静的サイト生成フレームワークに変換</li>
              <li>TypeScript の型エラーをゼロにする</li>
              <li>画像・フォント・色などのアセットをサイト用に整理</li>
              <li>GitHubリポジトリへのコミットとプッシュ</li>
            </ul>

            <p>ここで Astro という単語が出てきました。Astro とは、表示が高速な軽量サイトを作るための仕組みです。WordPressのように動的にページを生成するのではなく、あらかじめ全ページを書き出しておく方式（静的サイト）なので、表示が速く、運用コストも低く済みます。</p>

            <p>Claude Code の何がすごいかというと、これらの作業を「日本語の指示」だけで進められる点です。</p>

            <pre><code>{`私：「Claude Design で作った HTML を Astro プロジェクトに変換してください」
Claude Code：「了解しました。プロジェクト構造を作成し、各ページを .astro ファイルに変換します」`}</code></pre>

            <p>このやり取りだけで、5画面分のサイトが Astro プロジェクトとして組み上がりました。私は一行もコードを書いていません。</p>

            <h3>Vercel を選んだ理由は何か?</h3>

            <p><strong>Vercel は、GitHub に置いたコードをワンクリックで本番公開できるホスティングサービスです。個人利用なら無料で使え、ドメイン設定も簡単です。</strong></p>

            <p>ホスティングサービスは他にも GitHub Pages、Netlify、Cloudflare Pages などがあります。今回 Vercel を選んだのは次の3つの理由です。</p>

            <table>
              <thead>
                <tr><th>理由</th><th>内容</th></tr>
              </thead>
              <tbody>
                <tr><td>① Astroとの相性</td><td>Vercelは Astro の公式推奨ホスティングの1つ</td></tr>
                <tr><td>② デプロイの簡単さ</td><td>GitHubと連携すれば、push するたびに自動公開</td></tr>
                <tr><td>③ 無料枠が十分</td><td>個人サイト規模なら、月額0円で運用可能</td></tr>
              </tbody>
            </table>

            <p>「デプロイ」とは、書いたコードを本番のサイトとして公開することです。Vercel では、GitHub のリポジトリを連携するだけで、その後はコードを更新するたびに自動で公開してくれます。一度設定すれば、以降は何も意識しなくて済む仕組みです。</p>

            <p>3ツールの役割分担が見えたところで、次は実際の1日のスケジュールに入ります。ただ、その前に「GitHub」「Astro」「Vercel」という言葉に馴染みのない方のために、短い補足を挟ませてください。これを読んでおくと、次のセクションの体感が一段くっきりします。</p>

            <hr />

            <h2>補足解説:GitHub・Astro・Vercel をやさしく理解する</h2>

            <p><strong>ここまでに「GitHub」「Astro」「Vercel」という単語が何度か登場しました。次のセクションから具体的な作業手順に入る前に、この3つを身近な比喩で整理しておきます。PCの基本操作はできるが、Web技術の用語は初めて、という方を想定した補足です。</strong></p>

            <p>このサイト制作で出てくる言葉のうち、<strong>Claude Design・Claude Code 以外</strong>の3つの裏方ツールは、それぞれ役割が違います。最初は混同しやすいので、出版業界に置き換えて考えてみます。</p>

            <h3>出版に置き換えて考えると分かりやすい</h3>

            <table>
              <thead>
                <tr><th>Web用語</th><th>役割の比喩</th><th>何をしてくれるか</th></tr>
              </thead>
              <tbody>
                <tr><td><strong>GitHub</strong></td><td>原稿の保管庫付き図書館</td><td>書いた原稿(コード)を保管し、いつ誰がどこを直したかの履歴を全部残す</td></tr>
                <tr><td><strong>Astro</strong></td><td>印刷工場</td><td>同じ原稿データから、すばやく届けられる完成品(静的サイト)を大量に印刷する</td></tr>
                <tr><td><strong>Vercel</strong></td><td>出版・配送センター</td><td>印刷した本を、世界中の読者にすばやく届ける流通網を持っている</td></tr>
              </tbody>
            </table>

            <p>3つの関係を一文で言えば、<strong>「GitHubに保管された原稿を、Astroが本に仕上げ、Vercelが世界中に配る」</strong>となります。私たちは、この流れを一度設定するだけで、あとは「原稿を更新する」だけでサイトが自動で世界中に届きます。</p>

            <h3>なぜこの3つがセットで使われるのか?</h3>

            <p><strong>結論から言うと、それぞれが得意分野を分担しているからです。1社のサービスにすべてを任せる従来の方式(WordPressなど)よりも、軽くて速くて安くなります。</strong></p>

            <p>それぞれの得意分野を整理します。</p>

            <ul>
              <li><strong>GitHub</strong>:変更履歴の管理が得意。「3日前のバージョンに戻したい」も簡単</li>
              <li><strong>Astro</strong>:表示速度が得意。読者を待たせない軽いサイトが作れる</li>
              <li><strong>Vercel</strong>:公開作業が得意。GitHubに変更を上げると、自動で本番に反映してくれる</li>
            </ul>

            <p>特に最後の「自動で本番に反映」が、従来のWeb制作と一番違う点です。昔のWeb制作では、ファイルをサーバーに手動でアップロードする必要がありました。Vercelを使うと、その作業が消えます。<strong>「原稿を保存する感覚で、本番が更新される」</strong>という新しい体験が手に入ります。</p>

            <h3>この3つは、すべて無料で使える</h3>

            <p><strong>個人サイト規模であれば、GitHub・Vercelとも無料プランで十分です。Astroはオープンソースなので、そもそも料金という概念がありません。</strong></p>

            <p>これは初心者にとって大きな安心材料です。「使いこなせなかったら課金が無駄になる」という心配がありません。失敗しても、お金は1円もかかっていない状態です。<strong>3つすべて、登録だけしておいて、使わなくても損をしない</strong>という気軽さがあります。</p>

            <h3>用語に詳しくなる必要はない</h3>

            <p>ここまで読んで「やっぱり難しい」と感じても大丈夫です。<strong>この3つの中身を完全に理解する必要はありません</strong>。Claude Codeに「GitHubにpushして」「Vercelにデプロイして」と日本語で頼めば、適切な操作を進めてくれます。</p>

            <p>ただ、頭の片隅に「GitHub=保管庫」「Astro=印刷工場」「Vercel=配送センター」というイメージがあると、エラーが出たときに「これはどの段階で起きているのか?」が見えやすくなります。次のセクションで紹介する1日のスケジュールも、この3つの役割を行き来する旅だと思って読んでください。</p>

            <p>ここからの手順は、本章で説明した3つのツールが、実際にどう動くかの実例です。</p>

            <hr />

            <h2>1日のスケジュールはどう進んだのか?(時系列レポ)</h2>

            <p><strong>4月25日の朝〜午後にClaude Designで5画面のデザインを完成、夕方〜夜にClaude CodeでAstro実装、4月26日早朝にGitHubへpushしてVercelで公開しました。実作業時間は合計でおよそ10時間です。</strong></p>

            <p>ここからは、私の1日を時系列で再現します。「1日でできる」を抽象的なフレーズで終わらせず、どのフェーズに何時間かかり、何が気持ちよく、何で迷ったのかを具体的に追っていきます。</p>

